<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Lead Qualification Fields</label>
    <description>Demo-org access that is not part of the Archon package: the Lead fields the WhatsApp agent collects (Project Type, its dependent Project Name, Budget), the Opportunity/Product2 demo fields, and the WhatsApp/Lead-trigger Apex. A new custom field has no field-level security for anyone, admins included, so without this it is invisible even to a describe.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>LeadAgentTriggerHandler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SendWhatsAppMessage</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <field>Lead.Project_Type__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Project_Name__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Budget__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.CompetitorIntel__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Product2.MaxDiscountPercent__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
