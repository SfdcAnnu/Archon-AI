<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <actionCalls>
        <name>Initiate_WhatsApp_Revival_Outreach</name>
        <label>Initiate WhatsApp Revival Outreach</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <actionName>WhatsAppRevivalInitiator</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>opportunityIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <environments>Default</environments>
    <interviewLabel>Opportunity Closed Lost Revival {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Closed Lost Revival</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Account_Latest_Closed_Opp</name>
        <label>Update Account Latest Closed Opp</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <connector>
            <targetReference>Initiate_WhatsApp_Revival_Outreach</targetReference>
        </connector>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Latest_closed_opp__c</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Account_Latest_Closed_Opp</targetReference>
        </connector>
        <filterFormula>AND( ISPICKVAL({!$Record.StageName}, &quot;Closed Lost&quot;), NOT(ISPICKVAL({!$Record__Prior.StageName}, &quot;Closed Lost&quot;)) )</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
