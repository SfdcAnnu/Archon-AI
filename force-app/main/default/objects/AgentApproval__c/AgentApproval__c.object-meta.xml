<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Approval</label>
    <pluralLabel>Agent Approvals</pluralLabel>
    <!-- One row per Approval node pause. Written by the Archon Node server
         (via the Setup admin's own connection) when a flow reaches an
         Approval node; decided by the approver from agentApprovalList
         (My Approvals tab) or the standard record page; AgentApprovalController
         posts the decision back to the server, which resumes the paused run. -->
    <nameField>
        <type>AutoNumber</type>
        <label>Approval Number</label>
        <displayFormat>APR-{0000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <fields>
        <fullName>AgentRunId__c</fullName>
        <label>Agent Run Id</label>
        <type>Text</type>
        <length>60</length>
        <description>The Archon server's AgentRun.id — the paused execution this decision resumes.</description>
    </fields>
    <fields>
        <fullName>AgentApiName__c</fullName>
        <label>Agent API Name</label>
        <type>Text</type>
        <length>255</length>
    </fields>
    <fields>
        <fullName>NodeLabel__c</fullName>
        <label>Approval Step</label>
        <type>Text</type>
        <length>255</length>
    </fields>
    <fields>
        <fullName>RecordId__c</fullName>
        <label>Related Record Id</label>
        <type>Text</type>
        <length>18</length>
    </fields>
    <fields>
        <fullName>ApproverId__c</fullName>
        <label>Approver</label>
        <type>Lookup</type>
        <referenceTo>User</referenceTo>
        <relationshipName>AgentApprovals</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Pending</fullName><default>true</default></value>
                <value><fullName>Approved</fullName><default>false</default></value>
                <value><fullName>Rejected</fullName><default>false</default></value>
                <value><fullName>TimedOut</fullName><default>false</default></value>
            </valueSetDefinition>
        </valueSet>
        <required>true</required>
    </fields>
    <fields>
        <fullName>ApprovalToken__c</fullName>
        <label>Approval Token</label>
        <type>Text</type>
        <length>60</length>
        <unique>true</unique>
        <description>Matches the Archon server's AgentRun.approvalToken — the join key used to resume.</description>
    </fields>
    <fields>
        <fullName>Comments__c</fullName>
        <label>Comments</label>
        <type>LongTextArea</type>
        <length>4096</length>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>TimeoutAt__c</fullName>
        <label>Timeout At</label>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>DecidedAt__c</fullName>
        <label>Decided At</label>
        <type>DateTime</type>
    </fields>
</CustomObject>
