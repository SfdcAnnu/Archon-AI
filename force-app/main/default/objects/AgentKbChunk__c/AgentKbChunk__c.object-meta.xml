<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent KB Chunk</label>
    <pluralLabel>Agent KB Chunks</pluralLabel>
    <!-- Salesforce-native RAG storage backend: chunk TEXT written here so a
         customer's knowledge-base content never has to leave their org.
         Written/read directly by the Archon Node server via the Setup
         admin's own connection (getOrgConnection) — not by end users. -->
    <nameField>
        <type>AutoNumber</type>
        <label>Chunk Number</label>
        <displayFormat>KB-{0000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <fields>
        <fullName>AgentApiName__c</fullName>
        <label>Agent API Name</label>
        <type>Text</type>
        <length>255</length>
        <required>true</required>
    </fields>
    <fields>
        <fullName>DocumentExternalId__c</fullName>
        <label>Document External Id</label>
        <type>Text</type>
        <length>255</length>
        <required>true</required>
        <description>The Archon server's KbDocument.id — groups chunks belonging to the same uploaded document.</description>
    </fields>
    <fields>
        <fullName>DocumentTitle__c</fullName>
        <label>Document Title</label>
        <type>Text</type>
        <length>255</length>
    </fields>
    <fields>
        <fullName>ChunkIndex__c</fullName>
        <label>Chunk Index</label>
        <type>Number</type>
        <precision>8</precision>
        <scale>0</scale>
        <defaultValue>0</defaultValue>
    </fields>
    <fields>
        <fullName>Content__c</fullName>
        <label>Content</label>
        <type>LongTextArea</type>
        <length>131072</length>
        <visibleLines>10</visibleLines>
    </fields>
</CustomObject>
