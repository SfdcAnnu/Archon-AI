<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Archon AI Engine Admin</label>
    <description>Full admin over AI engine credentials, including Shared connections org-wide.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <license>Salesforce</license>

    <userPermissions>
        <enabled>true</enabled>
        <name>ViewEncryptedData</name>
    </userPermissions>

    <objectPermissions>
        <object>AiEngineConnection__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>

    <!-- Optional-field FLS only — required fields are implicitly readable/editable -->
    <fieldPermissions><field>AiEngineConnection__c.User__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.Endpoint__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.DefaultModel__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.IsActive__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.IsPreferred__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.IsPublicShared__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.LastValidatedAt__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.LastUsedAt__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.ValidationStatus__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>AiEngineConnection__c.Notes__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <fieldPermissions><field>AgentNode__c.AiEngineConnection__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>ChatSession__c.TitleGeneratedByAi__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
</PermissionSet>
