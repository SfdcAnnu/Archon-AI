# Which provider the ROOT agent + subagents use when a node doesn't specify one.
# One of: openai | anthropic | google | demo
# "demo" runs a scripted offline model — no API key needed, useful to watch the
# graph mechanics (routing, tool calls, approval interrupt) without spending tokens.
PROVIDER=demo

# Only the key for the provider(s) you actually use is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
